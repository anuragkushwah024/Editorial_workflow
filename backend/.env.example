# Copy this file to backend/.env for local development. Never commit .env.
# On Render, set the same names under Environment (values in brackets are for production).

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# True only on your own machine. [False]
DJANGO_DEBUG=True
# Comma-separated. Render's own address is added automatically. [leave empty or add a custom domain]
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local: your own PostgreSQL. [Supabase "Session pooler" connection string, port 5432]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/editorial
# [True] Supabase requires SSL.
DATABASE_SSL_REQUIRE=False

# The address of the React app, comma-separated. [https://your-app.vercel.app]
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Needed only for the Django admin login form. [https://your-api.onrender.com]
CSRF_TRUSTED_ORIGINS=

# [True for the first deploy] Create the demo users and articles during the build.
SEED_DEMO=False

# [3.12.7] Render reads this to pick the Python version.
# PYTHON_VERSION=3.12.7
